---
import { github, profile } from '../data/content';

const year = new Date().getFullYear();
---

<footer id="contact" class="border-t border-line/70">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-5 py-10">
    <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between">
      <p class="font-mono text-xs text-mist">
        © {year} {profile.name}. Built with Astro, Tailwind CSS, and Playwright.
      </p>
      <nav aria-label="Contact" class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs">
        <a href="/uses" class="text-mist hover:text-signal">
          /uses
        </a>
        <a
          href={`mailto:${profile.email}`}
          class="text-mist hover:text-signal"
        >
          {profile.email}
        </a>
        <a href={profile.phoneHref} class="text-mist hover:text-signal">
          {profile.phone}
        </a>
        <a
          href={profile.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="text-mist hover:text-signal"
        >
          LinkedIn
        </a>
        <a
          href={github.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-mist hover:text-signal"
        >
          GitHub
        </a>
      </nav>
    </div>
    <p class="font-mono text-xs text-mist/70">{profile.location}</p>
  </div>
</footer>
