---
import { nav, profile } from '../data/content';
---

<header
  transition:persist="site-header"
  class="site-header sticky z-50 border-b border-line/70 bg-void/80 backdrop-blur-md"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4">
    <a href="/" class="group no-underline" aria-label={profile.name}>
      <img
        src="/favicon.svg"
        alt=""
        width="48"
        height="48"
        class="h-12 w-12 rounded-xl"
      />
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-4 xl:gap-5 lg:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'whitespace-nowrap font-mono text-[11px] uppercase tracking-[0.16em] transition-colors [word-spacing:-0.45em]',
              item.href === '/#connect'
                ? 'ml-2 border-l border-line pl-4 text-signal hover:text-paper'
                : 'text-mist hover:text-signal',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-4 md:flex">
      <a
        href={profile.github}
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-xs uppercase tracking-[0.16em] text-mist hover:text-signal"
      >
        GitHub
      </a>
      <a
        href={profile.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-xs uppercase tracking-[0.16em] text-signal hover:underline"
      >
        LinkedIn
      </a>
    </div>

    <details class="relative lg:hidden">
      <summary
        class="cursor-pointer list-none rounded-md border border-line px-3 py-1.5 font-mono text-xs uppercase tracking-[0.16em] text-mist marker:content-none [&::-webkit-details-marker]:hidden"
      >
        Menu
      </summary>
      <nav
        aria-label="Mobile"
        class="absolute right-0 mt-2 w-52 rounded-lg border border-line bg-panel p-3 shadow-xl"
      >
        {
          nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'block whitespace-nowrap rounded-md px-3 py-2 font-mono text-xs uppercase tracking-[0.16em] [word-spacing:-0.45em] hover:bg-ink',
                item.href === '/#connect'
                  ? 'text-signal hover:text-paper'
                  : 'text-mist hover:text-signal',
              ]}
            >
              {item.label}
            </a>
          ))
        }
        <a
          href={profile.github}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-1 block rounded-md px-3 py-2 font-mono text-xs uppercase tracking-[0.16em] text-mist hover:bg-ink hover:text-signal"
        >
          GitHub
        </a>
        <a
          href={profile.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="block rounded-md px-3 py-2 font-mono text-xs uppercase tracking-[0.16em] text-signal hover:bg-ink"
        >
          LinkedIn
        </a>
      </nav>
    </details>
  </div>
</header>

<script>
  function syncVisualViewportTop() {
    const offset = window.visualViewport?.offsetTop ?? 0;
    document.documentElement.style.setProperty('--vv-top', `${offset}px`);
  }

  syncVisualViewportTop();

  if (document.documentElement.dataset.vvBound !== 'true') {
    document.documentElement.dataset.vvBound = 'true';
    window.visualViewport?.addEventListener('resize', syncVisualViewportTop);
    window.visualViewport?.addEventListener('scroll', syncVisualViewportTop);
    window.addEventListener('orientationchange', syncVisualViewportTop);
  }
</script>
