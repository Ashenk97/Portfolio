---
import { connect, github, profile } from '../data/content';
---

<section id="connect" class="border-t border-line/70">
  <div class="mx-auto max-w-6xl px-5 py-24">
    <div class="flex items-center gap-5">
      <h2 class="shrink-0 font-display text-3xl font-bold tracking-tight text-signal sm:text-4xl">
        <span class="mr-2 font-mono text-2xl font-medium sm:text-3xl">// </span>
        Let's connect
      </h2>
      <span class="hidden h-px flex-1 bg-line sm:block"></span>
    </div>

    <div
      class="relative mt-10 overflow-hidden rounded-2xl border border-signal/30 bg-panel p-6 shadow-[0_0_0_1px_rgb(62_224_197_/_0.1)] sm:p-10"
    >
      <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-signal/70 to-transparent"></div>

      <div class="grid gap-10 lg:grid-cols-2 lg:gap-14">
        <div>
          <p class="max-w-md text-lg leading-relaxed text-paper/90">{connect.intro}</p>

          <ul class="mt-8 space-y-4">
            <li class="flex items-start gap-3">
              <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-lg border border-signal/30 bg-signal/10 text-signal">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4" aria-hidden="true">
                  <rect x="2" y="7" width="20" height="14" rx="2"></rect>
                  <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"></path>
                </svg>
              </span>
              <div>
                <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-mist">Seeking</p>
                <p class="mt-1 text-paper">{connect.seeking}</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-lg border border-signal/30 bg-signal/10 text-signal">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4" aria-hidden="true">
                  <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"></path>
                  <circle cx="12" cy="10" r="2.5"></circle>
                </svg>
              </span>
              <div>
                <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-mist">Based in</p>
                <p class="mt-1 text-paper">{connect.basedIn}</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-lg border border-signal/30 bg-signal/10 text-signal">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4" aria-hidden="true">
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M12 7v5l3 2"></path>
                </svg>
              </span>
              <div>
                <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-mist">Response time</p>
                <p class="mt-1 text-paper">{connect.responseTime}</p>
              </div>
            </li>
          </ul>

          <ul class="mt-8 space-y-3 font-mono text-sm">
            <li>
              <a href={`mailto:${profile.email}`} class="inline-flex items-center gap-3 text-mist transition hover:text-signal">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4 text-signal" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                  <path d="m3 7 9 6 9-6"></path>
                </svg>
                {profile.email}
              </a>
            </li>
            <li>
              <a href={profile.phoneHref} class="inline-flex items-center gap-3 text-mist transition hover:text-signal">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4 text-signal" aria-hidden="true">
                  <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 6 6L16.5 13l4 1.5v3A2.5 2.5 0 0 1 18 20 15 15 0 0 1 4 6a2.5 2.5 0 0 1 2.5-3z"></path>
                </svg>
                {profile.phone}
              </a>
            </li>
            <li>
              <a
                href={profile.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-3 text-mist transition hover:text-signal"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 text-signal" aria-hidden="true">
                  <path d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1-.02-5zM3 9h4v12H3zM10 9h3.8v1.7h.05c.53-1 1.84-1.9 3.78-1.9 4.04 0 4.79 2.66 4.79 6.1V21h-4v-5.3c0-1.26-.02-2.88-1.76-2.88-1.76 0-2.03 1.37-2.03 2.79V21h-4z"></path>
                </svg>
                LinkedIn profile
              </a>
            </li>
            <li>
              <a
                href={github.profile}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-3 text-mist transition hover:text-signal"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 text-signal" aria-hidden="true">
                  <path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.5 2.87 8.32 6.84 9.67.5.1.68-.22.68-.48 0-.24-.01-.87-.01-1.7-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.1-1.5-1.1-1.5-.9-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.55-1.14-4.55-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.27 2.75 1.05A9.3 9.3 0 0 1 12 6.8c.85 0 1.7.12 2.5.34 1.9-1.32 2.74-1.05 2.74-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .26.18.59.69.48A10.04 10.04 0 0 0 22 12.26C22 6.58 17.52 2 12 2z"></path>
                </svg>
                GitHub
              </a>
            </li>
          </ul>
        </div>

        <form
          data-connect-form
          data-email={profile.email}
          class="flex flex-col gap-5"
          novalidate
        >
          <label class="block">
            <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-mist">Name</span>
            <input
              type="text"
              name="name"
              autocomplete="name"
              required
              placeholder="Your name"
              class="mt-2 w-full rounded-xl border border-line bg-ink px-4 py-3 text-paper outline-none transition placeholder:text-mist/50 focus:border-signal"
            />
          </label>
          <label class="block">
            <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-mist">Email</span>
            <input
              type="email"
              name="email"
              autocomplete="email"
              required
              placeholder="Your email"
              class="mt-2 w-full rounded-xl border border-line bg-ink px-4 py-3 text-paper outline-none transition placeholder:text-mist/50 focus:border-signal"
            />
          </label>
          <label class="block">
            <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-mist">Message</span>
            <textarea
              name="message"
              required
              rows="5"
              placeholder="How can I help you?"
              class="mt-2 w-full resize-y rounded-xl border border-line bg-ink px-4 py-3 text-paper outline-none transition placeholder:text-mist/50 focus:border-signal"
            ></textarea>
          </label>
          <p class="hidden">
            <label>
              Leave blank
              <input type="text" name="company" tabindex="-1" autocomplete="off" />
            </label>
          </p>
          <p data-connect-status class="hidden font-mono text-sm text-signal" role="status"></p>
          <button
            type="submit"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-signal px-5 py-3 font-semibold text-signal-fg transition hover:bg-signal/90 disabled:cursor-not-allowed disabled:opacity-60"
          >
            Send message
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true">
              <path d="M22 2 11 13"></path>
              <path d="m22 2-7 20-4-9-9-4 20-7z"></path>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  function bindConnectForm() {
    const form = document.querySelector<HTMLFormElement>('[data-connect-form]');
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const inbox = form.dataset.email ?? '';
    const status = form.querySelector<HTMLParagraphElement>('[data-connect-status]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!button || !status || !inbox) return;

      const data = new FormData(form);
      if (String(data.get('company') ?? '').trim()) return;

      const name = String(data.get('name') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const message = String(data.get('message') ?? '').trim();
      if (!name || !email || !message) {
        status.textContent = 'Fill in your name, email, and message.';
        status.classList.remove('hidden', 'text-signal');
        status.classList.add('text-ember');
        return;
      }

      button.disabled = true;
      status.classList.add('hidden');

      try {
        const response = await fetch(`https://formsubmit.co/ajax/${inbox}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify({
            name,
            email,
            message,
            _subject: `Portfolio message from ${name}`,
            _captcha: 'false',
          }),
        });

        if (!response.ok) throw new Error('Submit failed');

        form.reset();
        status.textContent = 'Success. Your message is on its way.';
        status.classList.remove('hidden', 'text-ember');
        status.classList.add('text-signal');
      } catch {
        const subject = encodeURIComponent(`Portfolio message from ${name}`);
        const body = encodeURIComponent(`${message}\n\n${name}\n${email}`);
        window.location.href = `mailto:${inbox}?subject=${subject}&body=${body}`;
        status.textContent = 'Opening your email app to send the note.';
        status.classList.remove('hidden', 'text-ember');
        status.classList.add('text-signal');
      } finally {
        button.disabled = false;
      }
    });
  }

  bindConnectForm();
  document.addEventListener('astro:page-load', bindConnectForm);
</script>
