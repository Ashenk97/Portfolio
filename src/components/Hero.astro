---
import { featuredCredential, profile } from '../data/content';
---

<section id="hero" class="relative overflow-hidden">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-24 md:py-32">
    <p
      class="font-mono text-xs uppercase tracking-[0.28em] text-signal"
      data-testid="role-kicker"
    >
      {profile.role}
    </p>
    <div class="max-w-4xl space-y-6">
      <h1 class="text-4xl leading-[1.05] text-paper sm:text-6xl md:text-7xl">
        {profile.name}
      </h1>
      <p class="max-w-3xl text-xl font-medium leading-relaxed tracking-[-0.02em] text-paper/90 sm:text-2xl">
        {profile.headline}
      </p>
      <p class="max-w-3xl text-base leading-relaxed text-mist sm:text-lg">
        {profile.about}
      </p>
    </div>
    <ul class="flex flex-wrap items-center gap-2">
      <li>
        <a
          href={featuredCredential.href}
          class="inline-flex items-center gap-2 rounded-full border border-signal/50 bg-signal/10 px-3 py-1 font-mono text-[11px] uppercase tracking-[0.14em] text-signal shadow-[0_0_0_1px_rgb(62_224_197_/_0.12)] transition hover:bg-signal/20"
        >
          <span class="rounded-full bg-signal px-1.5 py-0.5 text-[9px] font-semibold tracking-[0.12em] text-signal-fg">
            {featuredCredential.acronym}
          </span>
          <span>{featuredCredential.label}</span>
        </a>
      </li>
      {
        profile.personalSkills.map((skill) => (
          <li class="rounded-full border border-line bg-panel px-3 py-1 font-mono text-[11px] uppercase tracking-[0.14em] text-mist">
            {skill}
          </li>
        ))
      }
    </ul>
    <div class="flex flex-wrap items-center gap-6">
      <a
        href="/#experience"
        class="rounded-full bg-signal px-6 py-3 text-sm font-semibold text-signal-fg transition hover:brightness-110"
      >
        View experience
      </a>
      <a
        href={`mailto:${profile.email}`}
        class="font-mono text-xs uppercase tracking-[0.18em] text-mist underline-offset-4 hover:text-paper hover:underline"
      >
        {profile.email}
      </a>
      <span class="font-mono text-xs text-mist/80">{profile.location}</span>
    </div>
  </div>
</section>
