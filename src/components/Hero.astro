---
import { profile } from '../data/content';
---

<section id="hero" class="relative overflow-hidden">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-24 md:py-32">
    <p
      class="font-mono text-xs uppercase tracking-[0.28em] text-signal"
      data-testid="role-kicker"
    >
      {profile.role}
    </p>
    <div class="max-w-4xl space-y-6">
      <h1 class="text-4xl leading-[1.05] text-paper sm:text-6xl md:text-7xl">
        {profile.name}
      </h1>
      <p class="max-w-3xl text-xl font-medium leading-relaxed tracking-[-0.02em] text-paper/90 sm:text-2xl">
        {profile.headline}
      </p>
      <p class="max-w-3xl text-base leading-relaxed text-mist sm:text-lg">
        {profile.about}
      </p>
    </div>
    <dl
      class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4"
      data-testid="highlights"
    >
      {
        profile.highlights.map((item) => (
          <div class="rounded-2xl border border-line bg-panel px-4 py-5">
            <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-mist">
              {item.label}
            </dt>
            <dd class="mt-2 text-xl font-semibold tracking-tight text-signal">
              {item.value}
            </dd>
          </div>
        ))
      }
    </dl>
    <ul class="flex flex-wrap items-center gap-2">
      {
        profile.personalSkills.map((skill) => (
          <li class="rounded-full border border-line bg-panel px-3 py-1 font-mono text-[11px] uppercase tracking-[0.14em] text-mist">
            {skill}
          </li>
        ))
      }
    </ul>
  </div>
</section>
